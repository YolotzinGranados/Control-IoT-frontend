# Amazon RDS MySQL
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=replace-with-secret
DB_NAME=vehiculo_iot
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10

# Auth: generate a random secret of at least 32 characters
AUTH_SECRET_KEY=replace-with-random-secret-minimum-32-characters
AUTH_ACCESS_TTL_MINUTES=10
AUTH_REFRESH_TTL_DAYS=14
AUTH_REFRESH_COOKIE_NAME=iot_refresh
AUTH_CSRF_COOKIE_NAME=iot_csrf

# Legacy API keys are disabled by default; keep false in production
API_KEY_ADMIN=
API_KEY_CONTROL=
ENABLE_LEGACY_API_KEYS=false
